# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://beyondaivsai.com"

# AUTHOR_NOTIFICATION_EMAIL: Destination email for book orders, bulk orders, and enquiries.
AUTHOR_NOTIFICATION_EMAIL="harshverma59@gmail.com"

# Optional SMTP Configuration for Direct Nodemailer Email Delivery to AUTHOR_NOTIFICATION_EMAIL
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional Hosted Checkout & Email Provider Webhook Configuration
DIRECT_CHECKOUT_ENABLED="false"
DIRECT_CHECKOUT_URL=""
EMAIL_PROVIDER_WEBHOOK_URL=""
